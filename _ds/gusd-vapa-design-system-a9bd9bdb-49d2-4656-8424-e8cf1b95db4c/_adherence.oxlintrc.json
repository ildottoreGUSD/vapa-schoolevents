{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/data/**",
              "components/publication/**",
              "ui_kits/strategic-plan/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Inter))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|phase|title|steps|impact|impactLabel|funding|outcome|flag|key|ref|className|style|children)$/]",
        "message": "<ActionCard> doesn't accept that prop. Declared props: number, phase, title, steps, impact, impactLabel, funding, outcome, flag."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionCard'] > JSXAttribute[name.name='impact'] > Literal[value!=/^(?:low|medium|high)$/]",
        "message": "<ActionCard> impact must be one of 'low' | 'medium' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|as|href|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, as, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost|onDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|tone|columns|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: eyebrow, title, children, tone, columns."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:panel|dark)$/]",
        "message": "<Callout> tone must be one of 'panel' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisciplineCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:discipline|name|image|caption|tone|key|ref|className|style|children)$/]",
        "message": "<DisciplineCard> doesn't accept that prop. Declared props: discipline, name, image, caption, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisciplineCard'] > JSXAttribute[name.name='discipline'] > Literal[value!=/^(?:dance|media-arts|music|theatre|visual-arts)$/]",
        "message": "<DisciplineCard> discipline must be one of 'dance' | 'media-arts' | 'music' | 'theatre' | 'visual-arts'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisciplineCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<DisciplineCard> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|rule|size|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, rule, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|gold|navy|muted)$/]",
        "message": "<Eyebrow> tone must be one of 'blue' | 'gold' | 'navy' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Eyebrow> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImpactTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|note|children|key|ref|className|style|children)$/]",
        "message": "<ImpactTag> doesn't accept that prop. Declared props: level, note, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImpactTag'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:low|medium|high)$/]",
        "message": "<ImpactTag> level must be one of 'low' | 'medium' | 'high'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|children|lead|level|tone|rule|align|key|ref|className|style|children)$/]",
        "message": "<PageHeading> doesn't accept that prop. Declared props: eyebrow, children, lead, level, tone, rule, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<PageHeading> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PageHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|tone|key|ref|className|style|children)$/]",
        "message": "<ProgressMeter> doesn't accept that prop. Declared props: label, value, max, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressMeter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|green|amber|purple)$/]",
        "message": "<ProgressMeter> tone must be one of 'blue' | 'green' | 'amber' | 'purple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|size|key|ref|className|style|children)$/]",
        "message": "<StatFigure> doesn't accept that prop. Declared props: value, label, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|green|amber|purple|navy)$/]",
        "message": "<StatFigure> tone must be one of 'blue' | 'green' | 'amber' | 'purple' | 'navy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatFigure'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<StatFigure> size must be one of 'sm' | 'md'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
